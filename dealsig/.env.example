# Local evaluation: development permits demo data and the explicit billing bypass.
# Production: use APP_ENV=production, HTTPS, and disable all demo settings.
APP_ENV=development
BASE_URL=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,dealsig.ai,www.dealsig.ai
COOKIE_SECURE=false
SESSION_SECRET=replace-with-at-least-32-cryptographically-random-characters

POSTGRES_DB=dealsig
POSTGRES_USER=dealsig
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DEALSIG_BIND_ADDRESS=127.0.0.1
DEALSIG_PORT=8080

DEMO_MODE=true
BILLING_BYPASS=true
SEED_DEMO_DATA=true
REFRESH_INTERVAL_MINUTES=15

# Resend: create a sending-only key and verify dealsig.ai (or a sending subdomain).
RESEND_API_KEY=
RESEND_FROM_EMAIL="DealSig AI <access@dealsig.ai>"

# Stripe sandbox first. Use a recurring Price ID created for DealSig Pro.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Reserved for a licensed AVM/comparable-sales provider. Live records remain unscored without it.
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=

# Optional passwordless identity providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
COOKIE_SAME_SITE=lax
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:8080
