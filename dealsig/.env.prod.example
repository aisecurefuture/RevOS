# DealSig AI — production config for the co-hosted RevOS stack.
#
#   cp dealsig/.env.prod.example dealsig/.env.prod && nano dealsig/.env.prod
#
# Read by dealsig-db, dealsig-web, dealsig-worker and dealsig-backup in
# docker-compose.prod.yml. Deliberately SEPARATE from RevOS's root .env: both
# apps define POSTGRES_*, APP_ENV, COOKIE_SECURE, DATABASE_URL, STRIPE_* and
# RESEND_API_KEY, and one shared file would cross-wire the two stacks.
#
# The app refuses to boot when APP_ENV=production and any of the settings
# marked REQUIRED below is unsafe or missing (see app/config.py →
# validate_production). A bad value here shows up as dealsig-web crash-looping.

# --- Core -------------------------------------------------------------------
APP_ENV=production
BASE_URL=https://dealsig.ai
# Caddy redirects www -> apex, but TrustedHostMiddleware still sees whatever
# Host arrives, so keep both listed.
#
# 127.0.0.1 IS REQUIRED AND IS NOT OPTIONAL. The container HEALTHCHECK
# (dealsig/Dockerfile) calls urlopen('http://127.0.0.1:8080/healthz'), so the
# request carries `Host: 127.0.0.1:8080`. Starlette's TrustedHostMiddleware
# strips the port and compares `127.0.0.1` against this list; with it absent the
# middleware returns 400, urlopen raises HTTPError, the healthcheck exits 1, and
# the container reports UNHEALTHY FOREVER while serving dealsig.ai perfectly.
# That is not cosmetic: a real outage then looks identical to the standing false
# alarm, and any future `depends_on: {condition: service_healthy}` on
# dealsig-web would wait forever.
#
# Diagnosed 2026-08-16 after revos-dealsig-web-1 sat unhealthy for 11 days:
#   docker inspect --format '{{json .State.Health}}' revos-dealsig-web-1 \
#     | jq -r '.Log[-1].Output'   ->  urllib.error.HTTPError: HTTP Error 400
#
# No security is given up. Caddy routes by Host, so a request bearing
# `Host: 127.0.0.1` never matches the dealsig.ai site block and cannot reach the
# app from outside; only a process already inside the container can send it.
ALLOWED_HOSTS=dealsig.ai,www.dealsig.ai,127.0.0.1
# REQUIRED: >= 32 random chars. Left empty on purpose — an unedited copy of
# this file must fail loudly at boot rather than ship a known secret.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# REQUIRED true in production (cookies are HTTPS-only behind Caddy).
COOKIE_SECURE=true
# Use `none` only if you enable Apple SSO — its callback is a cross-site POST.
COOKIE_SAME_SITE=lax

# --- Database ---------------------------------------------------------------
# The host is `dealsig-db` (the compose service name), NOT `db` — `db` is
# RevOS's Postgres. Put the SAME password in POSTGRES_PASSWORD and in the
# DATABASE_URL below; they are read by different containers.
POSTGRES_DB=dealsig
POSTGRES_USER=dealsig
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://dealsig:PASSWORD-FROM-ABOVE@dealsig-db:5432/dealsig

# --- Production safety switches (REQUIRED false) ----------------------------
DEMO_MODE=false
BILLING_BYPASS=false
SEED_DEMO_DATA=false
REFRESH_INTERVAL_MINUTES=15

# --- Email (REQUIRED — the app will not start in production without a key) --
# Verify dealsig.ai (or a sending subdomain) in Resend and create a
# sending-only key. SPF/DKIM must be live before mail will deliver.
RESEND_API_KEY=
RESEND_FROM_EMAIL="DealSig AI <access@dealsig.ai>"
# Added as Reply-To on every Resend send. Comma-separated; optional. On contact
# form mail the submitter is listed first, then these.
RESEND_REPLY_TO=

# --- Contact / feedback form ------------------------------------------------
# Inboxes that receive /contact submissions. Comma-separated. The form is
# disabled (and says so) until this is set — a submitter can never choose the
# recipient, which is what stops the endpoint being usable as an open relay.
CONTACT_RECIPIENTS=

# Bot protection. The visible control is a single "I am not a robot" checkbox;
# ticking it makes the browser solve a server-signed proof of work before the
# send button unlocks. No third-party captcha, so the CSP stays script-src
# 'self' and no visitor data leaves the box.
# Difficulty in leading zero bits — each step up DOUBLES the work. 15 is ~0.25s
# in a browser. Raise it only if scripted submissions start getting through.
CONTACT_POW_BITS=15
# Emergency brake: hard ceiling on contact emails per UTC day. 0 = no cap
# (default), so a real customer is never turned away. Set a number only if bots
# ever get past the challenge and start costing Resend overage.
CONTACT_DAILY_LIMIT=0

# --- Passkeys (WebAuthn) ----------------------------------------------------
# RP ID is the registrable domain; ORIGIN must be the exact https origin.
PASSKEY_RP_ID=dealsig.ai
PASSKEY_ORIGIN=https://dealsig.ai

# --- Stripe -----------------------------------------------------------------
# Webhook endpoint to register in Stripe: https://dealsig.ai/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Market data ------------------------------------------------------------
# Licensed AVM / comparable-sales provider. Live records stay unscored until
# these are set.
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=

# --- Optional passwordless identity providers -------------------------------
# Redirect URIs live under https://dealsig.ai/auth/sso/<provider>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
