# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Environment / secrets — NEVER commit real secrets
# (keep templates like .env.example and .env.prod.example; block real .env files)
.env
.env.*
!.env*.example

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
npm-debug.log*
yarn-error.log*

# Database dumps — NEVER commit these.
# The nightly backup containers write full pg_dump output for BOTH products
# into ./backups (docker-compose.prod.yml mounts it), so without this rule a
# single `git add -A` on the server publishes complete production databases to
# github.com/aisecurefuture/RevOS. Found untracked-but-not-ignored on the box
# on 2026-08-16 with 16 dumps present.
backups/
*.sql
*.sql.gz
*.dump

# Local storage / media
backend/storage/
backend/media/
*.sqlite3
*.db

# Docker / OS
.DS_Store
*.log
docker-data/
postgres-data/
redis-data/
data/

# Editor
.idea/
.vscode/
*.swp
